# ---------------------------------------------------------------------------
# Local secrets for the Aegis backend. Copy to `backend/.env` and fill in.
# `backend/.env` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- AI provider (required for AI features; all calls stay server-side) -----
# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here
AI_ENABLED=true
AI_PROVIDER=groq
# Leave blank to auto-select from the provider's live model list.
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_INPUT_CHARS=6000
AI_RATE_LIMIT_PER_MINUTE=20

# --- Optional: OpenAI-compatible provider instead of Groq -------------------
OPENAI_API_KEY=

# --- Transactions / limits ---------------------------------------------------
MAX_UPLOAD_BYTES=209715200
MAX_ROWS=500000
MAX_COLUMNS=1000
ANALYSIS_WORKERS=2
STAGE_TIMEOUT_SECONDS=900

# --- Server ------------------------------------------------------------------
SECRET_KEY=dev-insecure-secret-change-me
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=336

# --- Supabase Auth: real email one-time passcodes (preferred) ----------------
# When set, Supabase Auth emails the passcode and verifies it; the SMTP block
# below is then unused. Use the project base URL only — a pasted `/rest/v1`
# suffix is tolerated. Read server-side only: this app never talks to Supabase
# from the browser, so the key is never bundled or sent to a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_TIMEOUT_SECONDS=20
# Must match Auth -> Email OTP Expiry in the Supabase dashboard.
SUPABASE_OTP_TTL_SECONDS=3600
# Where the emailed sign-in link lands (the page that finishes sign-in).
# Supabase only honours a redirect whose scheme+host match the project's Site
# URL — the port is ignored for loopback hosts — otherwise the link falls back
# to Site URL and can open a port nothing is serving. In production set this to
# https://your-app.example.com/auth/callback and add it to Auth -> URL
# Configuration -> Redirect URLs.
SUPABASE_REDIRECT_TO=http://localhost:5173/auth/callback

# --- Which component delivers passcodes --------------------------------------
# Empty = auto-detect (Supabase when configured, else SMTP, else dev console).
#   supabase    Supabase generates, emails and verifies the code.
#   smtp        WE generate the code and email it from the SMTP block below.
#               Use this when Supabase's built-in mailer is exhausted: it is
#               capped at ~2 messages/hour per project and that cap cannot be
#               raised from this repo, while SMTP has a normal quota.
#   dev_console No email at all: the code comes back in the API response and is
#               filled in on screen. Local development only.
OTP_PROVIDER=
OTP_REQUEST_COOLDOWN_SECONDS=30

# --- Email one-time passcodes (smtp provider, or fallback when Supabase is
# --- not set). Without SMTP the code is returned in the response (dev only).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char app password>,
# SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# --- Admin console -----------------------------------------------------------
# Comma-separated emails allowed into /api/admin/* (empty = nobody).
ADMIN_EMAILS=

# --- Brand -------------------------------------------------------------------
BRAND_NAME=Aegis
BRAND_DESCRIPTOR=AI Financial Intelligence
BRAND_TAGLINE=Upload Your Data. Discover What Matters.
BRAND_AUTH_PROVIDER=Freebuff
